[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Provider%
CatalogFile=OpenDesktopHID.cat
DriverVer=11/17/2026,0.1.0.0
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...19041

[Models.NTamd64.10.0...19041]
%Device%=Install,ROOT\OpenDesktopHID

[DestinationDirs]
DriverCopy=13

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
OpenDesktopHID.sys=1

[Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
OpenDesktopHID.sys

[Install.NT.HW]
AddReg=VhfFilter

[VhfFilter]
HKR,,LowerFilters,0x00010000,"vhf"

[Install.NT.Services]
AddService=OpenDesktopHID,0x00000002,DriverService

[DriverService]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\OpenDesktopHID.sys

[Install.NT.Wdf]
KmdfService=OpenDesktopHID,WdfSection

[WdfSection]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
Provider="OpenDesktopHID contributors"
Device="OpenDesktopHID virtual keyboard and mice (development)"
Disk="OpenDesktopHID development package"
